# Required in production. Use a random value, for example `openssl rand -hex 32`.
# It encrypts browser credential sessions and must remain stable across replicas.
KITCHEN_SESSION_SECRET=

# Optional single-tenant deployment mode. All four values must be set: users
# exchange KITCHEN_ACCESS_TOKEN for an HttpOnly session before the server-side
# Modal credentials can be used.
KITCHEN_ACCESS_TOKEN=
MODAL_TOKEN_ID=
MODAL_TOKEN_SECRET=
MODAL_ENVIRONMENT=
